---
import '@fontsource/anton/latin.css';
import antonWoff2 from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import Emblem from '../components/Emblem.astro';
import PulseMark from '../components/PulseMark.astro';

interface Props {
  title: string;
  description?: string;
  /** Structured data for the page, rendered as JSON-LD. */
  jsonld?: unknown;
  /** Robots meta, for example "noindex, follow" on list variants that crawlers should not fetch. */
  robots?: string;
  /** An Atom feed for this page, in place of the site-wide changes feed. */
  feed?: { href: string; title: string };
}
const {
  title,
  description = 'Is this MCP server alive? What does it cost your context window? Daily health and token cost of every remote server in the official MCP registry.',
  jsonld,
  robots,
  feed
} = Astro.props;
const path = Astro.url.pathname;
const nav: Array<[string, string]> = [
  ['/', 'Overview'],
  ['/check', 'Check'],
  ['/servers', 'Servers'],
  ['/statistics', 'Statistics'],
  ['/changes', 'Changes'],
  ['/methodology', 'Method']
];
const year = new Date().getFullYear();
const canonical = new URL(path + Astro.url.search, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'mcp-pulse' ? 'mcp-pulse' : `${title} · mcp-pulse`}</title>
    <script is:inline>
      // Before paint: the stored choice, else the system setting. No flash of the wrong theme.
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        document.documentElement.dataset.theme = t === 'light' || t === 'dark' ? t : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/atom+xml" title={feed?.title ?? 'mcp-pulse: what changed'} href={feed?.href ?? '/changes.xml'} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={antonWoff2} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f6f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1a17" media="(prefers-color-scheme: dark)" />
    <meta name="msvalidate.01" content="4F4EE13471EED503A00DC72F10CE2BB9" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <header class="band">
      <a href="/" class="brand cell" aria-label="mcp-pulse home">
        <PulseMark class="mark" />
        <span class="wordmark">mcp-pulse</span>
      </a>
      <script is:inline>
        // The trace runs to the end once started; a new hover waits for it to finish.
        (function () {
          var brand = document.querySelector('.brand');
          var mark = brand && brand.querySelector('.mark');
          if (!mark) return;
          brand.addEventListener('pointerenter', function () { mark.classList.add('play'); });
          mark.addEventListener('animationend', function () { mark.classList.remove('play'); });
        })();
      </script>
      <nav aria-label="Main" class="cells">
        {nav.map(([href, text]) => (
          <a href={href} class="cell cell-flood" aria-current={path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined}>{text}</a>
        ))}
        <a href="https://github.com/ondraulehla/mcp-pulse" rel="noopener" class="cell cell-flood">GitHub</a>
        <a href="https://www.npmjs.com/package/mcptop" rel="noopener" class="cell cell-flood wide">npx mcptop</a>
        <button type="button" class="cell cell-flood theme-toggle" data-theme-toggle aria-label="Switch between light and dark" title="Light / dark">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
        </button>
      </nav>
    </header>
    <script is:inline>
      document.querySelector('[data-theme-toggle]').addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
    <main>
      <slot />
    </main>
    <footer class="band foot">
      <a href="https://ulehla.dev" rel="me noopener" class="brand cell">
        <Emblem class="emblem small" />
        <span class="wordmark">© {year} Ondřej Úlehla</span>
      </a>
      <p class="note">Probed each day. Exact token counts from the Anthropic count_tokens endpoint. To exclude a server, open an issue.</p>
      <nav aria-label="Footer" class="cells">
        <a href="https://github.com/ondraulehla/mcp-pulse" rel="noopener" class="cell cell-flood">GitHub</a>
        <a href="https://www.npmjs.com/package/mcptop" rel="noopener" class="cell cell-flood">npm</a>
        <a href="https://ulehla.dev" rel="me noopener" class="cell cell-flood">ulehla.dev</a>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --surface: oklch(95.9% 0.023 84);
    --panel: oklch(93.2% 0.027 83);
    --ink: oklch(21% 0.012 55);
    --ink-muted: oklch(43% 0.016 55);
    --ink-faint: oklch(56% 0.016 62);
    --line: oklch(86.5% 0.028 82);
    --accent: oklch(55% 0.19 38);
    --accent-strong: oklch(47% 0.19 38);
    --accent-soft: oklch(90.5% 0.05 55);
    --up: oklch(52% 0.13 150);
    --up-soft: oklch(92% 0.05 150);
    --gated: oklch(50% 0.09 250);
    --gated-soft: oklch(92% 0.03 250);
    --chart-up: oklch(52% 0.13 150);
    --chart-gated: oklch(50% 0.12 250);
    --chart-accent: oklch(55% 0.19 38);
    --font-sans: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --font-display: var(--font-sans);
    --font-poster: 'Anton', Impact, 'Arial Narrow Bold', sans-serif;
    --font-mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    --gutter: clamp(16px, 4vw, 40px);
    color-scheme: light;
  }
  /* Dark: the stored choice, or the system setting when nothing is stored. Chart hues are a separate, validated set. */
  :root[data-theme="dark"] {
      --surface: oklch(17% 0.008 65);
      --panel: oklch(21% 0.01 65);
      --ink: oklch(93% 0.012 80);
      --ink-muted: oklch(70% 0.016 70);
      --ink-faint: oklch(55% 0.016 65);
      --line: oklch(29% 0.012 65);
      --accent: oklch(70% 0.17 38);
      --accent-strong: oklch(77% 0.15 45);
      --accent-soft: oklch(27% 0.05 45);
      --up: oklch(72% 0.14 150);
      --up-soft: oklch(26% 0.05 150);
      --gated: oklch(72% 0.09 250);
      --gated-soft: oklch(26% 0.04 250);
      --chart-up: oklch(66% 0.14 150);
      --chart-gated: oklch(66% 0.12 250);
      --chart-accent: oklch(66% 0.17 38);
      color-scheme: dark;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --surface: oklch(17% 0.008 65);
      --panel: oklch(21% 0.01 65);
      --ink: oklch(93% 0.012 80);
      --ink-muted: oklch(70% 0.016 70);
      --ink-faint: oklch(55% 0.016 65);
      --line: oklch(29% 0.012 65);
      --accent: oklch(70% 0.17 38);
      --accent-strong: oklch(77% 0.15 45);
      --accent-soft: oklch(27% 0.05 45);
      --up: oklch(72% 0.14 150);
      --up-soft: oklch(26% 0.05 150);
      --gated: oklch(72% 0.09 250);
      --gated-soft: oklch(26% 0.04 250);
      --chart-up: oklch(66% 0.14 150);
      --chart-gated: oklch(66% 0.12 250);
      --chart-accent: oklch(66% 0.17 38);
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  /* theme toggle: the sun shows in the dark (click for light), the moon in the light */
  .theme-toggle { width: 3.4rem; padding: 0; border: 0; border-left: 1px solid var(--line); background: transparent; color: var(--ink-muted); cursor: pointer; display: flex; align-items: center; justify-content: center; font: inherit; }
  .theme-toggle svg { width: 1.1rem; height: 1.1rem; }
  .theme-toggle .icon-sun { display: none; }
  :root[data-theme="dark"] .theme-toggle .icon-sun { display: block; }
  :root[data-theme="dark"] .theme-toggle .icon-moon { display: none; }

  /* charts: thin marks, one hue per series, hover lifts the mark and shows its tooltip, a table under each */
  .chart { margin: 14px 0 8px; }
  .chart [data-tip] { position: relative; outline: none; }
  .chart [data-tip]::after { content: attr(data-tip); position: absolute; left: 0; bottom: calc(100% + 6px); z-index: 2; padding: 5px 8px; border: 1px solid var(--line); background: var(--ink); color: var(--surface); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.04em; white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity 0.12s; }
  .chart [data-tip]:hover::after, .chart [data-tip]:focus-visible::after { opacity: 1; }
  .chart-table { margin: 6px 0 0; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); }
  .chart-table summary { cursor: pointer; width: max-content; }
  .chart-table summary:hover { color: var(--accent); }
  .chart-table table { margin-top: 8px; text-transform: none; letter-spacing: 0; font-family: var(--font-sans); font-size: 0.9rem; color: var(--ink); width: 100%; border: 1px solid var(--line); }
  .bars ol { list-style: none; margin: 0; padding: 0; }
  .bars .bar { display: grid; grid-template-columns: minmax(120px, 34%) 1fr; gap: 12px; align-items: center; padding: 5px 0; border-top: 1px solid var(--line); }
  .bars .bar:first-child { border-top: 0; }
  .bars .bar-label { font-size: 0.9rem; overflow-wrap: anywhere; line-height: 1.25; }
  .bars .bar-label small { display: block; color: var(--ink-faint); font-size: 0.74rem; }
  .bars .bar-track { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .bars .bar-fill { display: block; height: 18px; max-width: calc(100% - 64px); background: var(--chart-accent); border-radius: 0 4px 4px 0; transition: filter 0.12s; }
  .bars .bar.up .bar-fill { background: var(--chart-up); }
  .bars .bar.gated .bar-fill { background: var(--chart-gated); }
  .bars .bar.down .bar-fill { background: var(--chart-accent); }
  .bars .bar:hover .bar-fill, .bars .bar:focus-visible .bar-fill { filter: brightness(1.15); }
  .bars .bar-value { font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .stack-bar { display: flex; gap: 2px; height: 22px; background: var(--line); }
  .stack-bar .seg { display: block; flex: 0 0 auto; min-width: 2px; transition: filter 0.12s; }
  .stack-bar .seg:hover, .stack-bar .seg:focus-visible { filter: brightness(1.15); }
  .seg.up, .legend i.up { background: var(--chart-up); }
  .seg.gated, .legend i.gated { background: var(--chart-gated); }
  .seg.down, .legend i.down { background: var(--chart-accent); }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 22px; list-style: none; margin: 10px 0 0; padding: 0; font-size: 0.9rem; color: var(--ink-muted); }
  .legend i { display: inline-block; width: 12px; height: 12px; margin-right: 7px; vertical-align: -1px; }
  .legend b { font-weight: 600; color: var(--ink); margin-left: 4px; }
  .histogram ol { display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: 2px; list-style: none; margin: 0; padding: 0; height: 220px; }
  .histogram .col { display: grid; grid-template-rows: auto 1fr auto; gap: 6px; text-align: center; }
  .histogram .col-track { display: flex; align-items: flex-end; }
  .histogram .col-fill { display: block; width: 100%; max-width: 48px; margin: 0 auto; background: var(--chart-accent); border-radius: 4px 4px 0 0; transition: filter 0.12s; }
  .histogram .col:hover .col-fill, .histogram .col:focus-visible .col-fill { filter: brightness(1.15); }
  .histogram .col-value { font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .histogram .col-label { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.04em; color: var(--ink-faint); white-space: nowrap; }
  .histogram [data-tip]::after { left: 50%; transform: translateX(-50%); }
  .trend svg { width: 100%; height: auto; display: block; font-family: var(--font-mono); }
  .trend .grid line { stroke: var(--line); stroke-width: 1; }
  .trend .grid text, .trend .axis { fill: var(--ink-faint); font-size: 11px; }
  .trend .line { fill: none; stroke: var(--chart-accent); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .trend .hit { fill: transparent; }
  .trend .ring { fill: var(--surface); }
  .trend .dot { fill: var(--chart-accent); transition: r 0.12s; }
  .trend .pt { outline: none; cursor: default; }
  .trend .pt:hover .dot, .trend .pt:focus-visible .dot { r: 5.5; }
  .trend .tip { fill: var(--ink); font-size: 11px; opacity: 0; pointer-events: none; paint-order: stroke; stroke: var(--surface); stroke-width: 4px; }
  .trend .pt:hover .tip, .trend .pt:focus-visible .tip { opacity: 1; }
  .trend .end { fill: var(--ink); font-size: 12px; font-weight: 600; }
  @media (max-width: 640px) {
    .bars .bar { grid-template-columns: 1fr; gap: 4px; }
    .histogram ol { height: 160px; }
    .histogram .col-label { font-size: 0.52rem; }
    .chart [data-tip]::after { white-space: normal; max-width: 70vw; }
  }
  html { background: var(--surface); color: var(--ink); font-family: var(--font-sans); font-size: 16px; line-height: 1.5; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  body { margin: 0; min-height: 100svh; display: flex; flex-direction: column; }
  a { color: inherit; text-decoration: none; }
  main a:not(.cell):not(.plain) { color: var(--accent); }
  main a:not(.cell):not(.plain):hover { text-decoration: underline; text-underline-offset: 3px; }
  ::selection { background: var(--accent); color: var(--surface); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* technical band: hairline cells, like the header of ulehla.dev */
  .band { display: flex; align-items: stretch; justify-content: space-between; border-bottom: 1px solid var(--line); min-height: 4.25rem; }
  .band.foot { border-bottom: 0; border-top: 1px solid var(--line); margin-top: auto; }
  .cells { display: flex; align-items: stretch; }
  .cell { display: inline-flex; align-items: center; justify-content: center; padding: 0 1.1rem; border-left: 1px solid var(--line); font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted); white-space: nowrap; }
  .cell.wide { color: var(--accent); font-weight: 600; }
  .cell[aria-current] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--accent); }
  .brand { border-left: 0; gap: 0.8rem; padding-left: var(--gutter); color: var(--ink); }
  .wordmark { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600; }
  .brand .wordmark { font-size: 1.05rem; letter-spacing: 0.2em; }
  .emblem { width: 2.1rem; height: 2.1rem; color: var(--accent); }
  /* the mark: orange at rest; .play runs one full trace (draw in ink, then fade back to orange) */
  .mark { width: 2.1rem; height: 2.1rem; }
  .mark .base { stroke: var(--accent); }
  .mark .trace { stroke: var(--ink); stroke-dasharray: 100; stroke-dashoffset: 100; opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .mark.play .trace { animation: pulse-trace 1.3s cubic-bezier(0.4, 0, 0.2, 1) 1 both; }
  }
  @keyframes pulse-trace {
    0% { stroke-dashoffset: 100; opacity: 1; }
    55% { stroke-dashoffset: 0; opacity: 1; }
    70% { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  .emblem.small { width: 1.4rem; height: 1.4rem; }
  .cell-flood:hover, .cell-flood:focus-visible { color: var(--surface); background: var(--ink); }
  .note { display: none; align-items: center; margin: 0; padding: 0 1.5rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-faint); }
  @media (min-width: 900px) { .note { display: flex; } }
  @media (max-width: 720px) {
    .band { flex-wrap: wrap; }
    .brand { width: 100%; padding: 0.9rem var(--gutter); border-bottom: 1px solid var(--line); }
    .cells { width: 100%; overflow-x: auto; }
    .cell { flex: 1 0 auto; padding: 0.8rem 0.9rem; }
    .cell:first-child { border-left: 0; }
  }

  main { width: 100%; max-width: 1240px; margin: 0 auto; padding: clamp(28px, 5vw, 56px) var(--gutter) 64px; }

  /* type */
  .poster { font-family: var(--font-poster); text-transform: uppercase; letter-spacing: 0.01em; font-weight: 400; line-height: 0.92; margin: 0; }
  h1.poster { font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.6rem); }
  .display { font-family: var(--font-display); letter-spacing: -0.01em; }
  h2 { font-family: var(--font-display); font-size: clamp(1.35rem, 1.05rem + 1.2vw, 1.9rem); font-weight: 600; letter-spacing: -0.01em; margin: 56px 0 14px; }
  h2:first-of-type { margin-top: 40px; }
  .kicker { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 14px; }
  .answer { font-size: 1.1rem; margin: 18px 0 0; max-width: 70ch; line-height: 1.5; }
  .answer b { font-variant-numeric: tabular-nums; }
  .lede { font-size: 1.125rem; color: var(--ink-muted); max-width: 62ch; margin: 18px 0 0; line-height: 1.55; }
  .muted { color: var(--ink-muted); }
  .faint { color: var(--ink-faint); }
  .mono { font-family: var(--font-mono); font-size: 0.9em; }
  .small { font-size: 0.85rem; }
  .break { overflow-wrap: anywhere; }
  .num { font-variant-numeric: tabular-nums; text-align: right; }
  p { margin: 10px 0; }

  /* hairline stat cells: 1px gaps painted by the line colour */
  /* seven cells fit one row from about 960px up; below that they wrap */
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(124px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); margin: 32px 0 0; }
  .stat { background: var(--surface); padding: 18px 14px 16px; min-width: 0; }
  .stat b { display: block; font-family: var(--font-display); font-weight: 600; font-size: clamp(1.4rem, 0.9rem + 1.5vw, 2.1rem); line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .stat span { display: block; margin-top: 8px; font-family: var(--font-sans); font-size: 0.9rem; color: var(--ink-muted); line-height: 1.4; }

  /* share bar */

  /* tables */
  .frame { border: 1px solid var(--line); overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .frame table { min-width: 720px; }
  th, td { padding: 9px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  tbody tr:last-child td { border-bottom: 0; }
  th { font-family: var(--font-mono); font-weight: 500; font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); white-space: nowrap; background: var(--panel); }
  th.num, td.num { text-align: right; font-variant-numeric: tabular-nums; }
  main th a.sort { color: var(--ink-faint); }
  main th a.sort:hover { color: var(--ink); text-decoration: none; }
  main th a.sort.active { color: var(--ink); }
  th .arrow { margin-left: 4px; color: var(--accent); }
  tbody tr:hover { background: var(--panel); }
  td .sub { display: block; font-size: 0.78rem; color: var(--ink-faint); margin-top: 2px; }

  /* status tags: square, mono, a colour bar on the left */
  .tag { display: inline-block; padding: 2px 8px 2px 7px; border: 1px solid var(--line); border-left-width: 3px; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; color: var(--ink-muted); }
  .tag.up { border-left-color: var(--up); color: var(--up); background: var(--up-soft); }
  .tag.gated { border-left-color: var(--gated); color: var(--gated); background: var(--gated-soft); }
  .tag.down { border-left-color: var(--accent); color: var(--accent-strong); background: var(--accent-soft); }
  .tag.big { font-size: 0.8rem; padding: 5px 12px 5px 10px; }

  /* the check panel on the overview */
  .panel { border: 1px solid var(--accent); padding: 12px 14px 12px; margin: 22px 0 0; background: var(--panel); }
  .panel h2.panel-title { font-size: 0.95rem; margin: 0 0 8px; }
  .panel .checkform input { padding: 9px 12px; font-size: 0.95rem; }
  .panel .checkform button { padding: 0 18px; }
  .checkform { display: flex; gap: 0; border: 1px solid var(--line); background: var(--surface); }
