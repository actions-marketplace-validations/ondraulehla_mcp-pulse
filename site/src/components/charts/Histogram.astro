---
/**
 * Columns for ordered bands of one measure: one hue, the count on each cap,
 * the hovered column lifts. Bands are labelled by their upper edge.
 */
interface Props {
  edges: number[];
  bins: number[];
  id: string;
  /** Link template for a band, with {lo} and {hi} placeholders. */
}
const { edges, bins, id } = Astro.props;
const fmt = (n: number) => (n >= 1000 ? `${n / 1000}k` : String(n));
const labels = bins.map((_, i) => (i === 0 ? `< ${fmt(edges[0])}` : i === edges.length ? `${fmt(edges[edges.length - 1])}+` : `${fmt(edges[i - 1])} – ${fmt(edges[i])}`));
const max = Math.max(1, ...bins);
const num = (n: number) => n.toLocaleString('en-US').replace(/,/g, ' ');
---

<figure class="chart histogram" id={id}>
  <ol style={`--cols:${bins.length}`}>
    {bins.map((n, i) => (
      <li class="col" tabindex="0" data-tip={`${labels[i]} tokens: ${num(n)} servers`}>
        <span class="col-value">{num(n)}</span>
        <span class="col-track"><span class="col-fill" style={`height:${Math.max(1, (n / max) * 100)}%`}></span></span>
        <span class="col-label">{labels[i]}</span>
      </li>
    ))}
  </ol>
  <details class="chart-table">
    <summary>as a table</summary>
    <table>
      <thead><tr><th>Tokens</th><th class="num">Servers</th></tr></thead>
      <tbody>{bins.map((n, i) => <tr><td>{labels[i]}</td><td class="num">{num(n)}</td></tr>)}</tbody>
    </table>
  </details>
</figure>
