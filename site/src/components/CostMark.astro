---
/**
 * The MCPCost mark: three bars, the token meter from the favicon, orange at
 * rest. On hover the bars grow from the baseline once and settle; a few lines
 * of script in the layout start the keyframes on pointer entry and clear them
 * when they finish, so leaving halfway changes nothing. People who asked for
 * less motion see the bars still.
 */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<svg class={`cost ${cls}`} viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
  <rect class="bar" x="5" y="18" width="6" height="9"></rect>
  <rect class="bar" x="13" y="12" width="6" height="15"></rect>
  <rect class="bar" x="21" y="5" width="6" height="22"></rect>
</svg>
