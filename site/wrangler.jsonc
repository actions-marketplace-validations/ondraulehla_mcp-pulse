{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcpcost",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": true,
  "routes": [
    { "pattern": "mcpcost.ulehla.dev", "custom_domain": true },
    // The old name stays as an alias; the middleware answers 301 to the new one.
    { "pattern": "mcp-pulse.ulehla.dev", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcp-pulse",
      "database_id": "f1984775-849a-4277-805e-537ea5ad7611"
    }
  ]
}
